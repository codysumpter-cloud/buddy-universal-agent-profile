{
  "$schema": "https://cdn.agentclientprotocol.com/registry/v1/latest/agent.schema.json",
  "id": "buddy-universal-agent-profile",
  "name": "Buddy Universal Agent Profile",
  "version": "0.2.0",
  "description": "BUAP-compatible ACP coding agent adapter for Xcode and ACP clients, with Buddy/Lil Buddy orchestration, personalization, guarded workspace tools, and model backend routing.",
  "repository": "https://github.com/codysumpter-cloud/buddy-universal-agent-profile",
  "website": "https://github.com/codysumpter-cloud/buddy-universal-agent-profile",
  "authors": ["Prismtek / Buddy ecosystem"],
  "license": "proprietary",
  "distribution": {
    "npx": {
      "package": "@prismtek/buap-acp-agent@0.2.0",
      "args": [],
      "env": {
        "BUAP_SURFACE": "xcode-acp",
        "BUAP_DEFAULT_BUDDY_PROFILE": "bmo",
        "BUAP_DEFAULT_LIL_BUDDY_PROFILE": "finn"
      }
    }
  }
}
