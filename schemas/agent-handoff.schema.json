{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/codysumpter-cloud/buddy-universal-agent-profile/main/schemas/agent-handoff.schema.json",
  "title": "BUAP Agent Handoff v1",
  "description": "Scope-and-provenance task brief, not an A2A endpoint or permission grant.",
  "type": "object",
  "required": [
    "schema",
    "request_id",
    "mission_id",
    "mission_sha256",
    "from_agent",
    "task_id",
    "action",
    "title",
    "scope",
    "capabilities",
    "source_refs",
    "required_checks",
    "limits",
    "authorization",
    "transport"
  ],
  "properties": {
    "schema": {
      "const": "prismtek-agent-handoff-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "from_agent": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "required": [
        "tokens",
        "cost_cents"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "action",
        "decision"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "allow",
            "ask",
            "deny",
            "handoff"
          ]
        }
      }
    },
    "transport": {
      "const": "host_managed"
    }
  }
}
