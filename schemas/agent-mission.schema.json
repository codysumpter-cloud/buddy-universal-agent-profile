{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/codysumpter-cloud/buddy-universal-agent-profile/main/schemas/agent-mission.schema.json",
  "title": "BUAP Agent Mission v1",
  "description": "Portable host-neutral DAG manifest; validation must also reject cycles and missing dependencies at runtime.",
  "type": "object",
  "required": [
    "id",
    "title",
    "budget",
    "steps"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "budget": {
      "type": "object",
      "required": [
        "max_tokens",
        "max_cost_cents",
        "max_parallel"
      ],
      "properties": {
        "max_tokens": {
          "$ref": "#/$defs/positiveOrZero"
        },
        "max_cost_cents": {
          "$ref": "#/$defs/positiveOrZero"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "action",
          "depends_on",
          "capabilities",
          "checks",
          "estimated_tokens",
          "estimated_cost_cents"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "uniqueItems": true
          },
          "estimated_tokens": {
            "$ref": "#/$defs/positiveOrZero"
          },
          "estimated_cost_cents": {
            "$ref": "#/$defs/positiveOrZero"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "positiveOrZero": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
