{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/codysumpter-cloud/buddy-universal-agent-profile/main/schemas/agent-life-event.schema.json",
  "title": "Prismtek Agent Life Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "agent_id",
    "occurred_at",
    "kind",
    "subject",
    "reward",
    "confidence",
    "authority",
    "evidence",
    "changes",
    "before_sha256",
    "after_sha256",
    "profile_sha256",
    "claim_boundary"
  ],
  "properties": {
    "schema": { "const": "prismtek-agent-life-event-v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "kind": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "reward": { "type": "number", "minimum": -1, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "authority": {
      "type": "object",
      "required": ["kind", "actor_id"],
      "properties": {
        "kind": { "enum": ["human", "host", "verifier"] },
        "actor_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["type", "ref"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "changes": { "type": "object", "additionalProperties": true },
    "before_sha256": { "type": "string", "minLength": 1 },
    "after_sha256": { "type": "string", "minLength": 1 },
    "profile_sha256": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
