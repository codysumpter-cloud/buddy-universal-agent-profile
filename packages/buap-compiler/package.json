{
  "name": "@prismtek/buap-compiler",
  "version": "0.2.0",
  "description": "Initialize, compile, validate, and diagnose portable BUAP repository policy.",
  "type": "module",
  "bin": {
    "buap": "src/cli.mjs",
    "buap-compile": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codysumpter-cloud/buddy-universal-agent-profile.git",
    "directory": "packages/buap-compiler"
  },
  "scripts": {
    "test": "node --test",
    "build:example": "node src/cli.mjs build --config examples/repository/buap.config.json",
    "check:example": "node src/cli.mjs check --config examples/repository/buap.config.json"
  },
  "engines": {
    "node": ">=20"
  }
}
